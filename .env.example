# LiveAvatar (heygen.com / liveavatar.com)
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Avatar IDs (from LiveAvatar dashboard)
KATYA_AVATAR_ID=your_avatar_id_here

# ElevenLabs Voice IDs (留空則自動使用 macOS TTS 作備用)
KATYA_VOICE_ID=
KIRA_VOICE_ID=
LEON_VOICE_ID=
MOMO_VOICE_ID=

# YouTube Live
# YOUTUBE_API_KEY 取得：console.cloud.google.com → API & Services → YouTube Data API v3
YOUTUBE_API_KEY=
# YOUTUBE_LIVE_CHAT_ID 取得：YouTube Studio → 直播 → 複製 liveChatId
# 或 API: GET https://www.googleapis.com/youtube/v3/liveBroadcasts?part=snippet&broadcastStatus=active
YOUTUBE_LIVE_CHAT_ID=

# TikTok Live
# TIKTOK_USERNAME：TikTok 帳號名稱（含或不含 @）
TIKTOK_USERNAME=
